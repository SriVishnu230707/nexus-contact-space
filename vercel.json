{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?route=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.js?route="
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index.js?route=favicon.ico"
    }
  ]
}
